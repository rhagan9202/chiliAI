{
  "name": "chili_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "codegen:api": "openapi-typescript ./openapi.json --output src/lib/api/schema.ts && node scripts/ensure-generated-api-header.mjs",
    "render:architecture": "mmdc -i ../docs/system_architecture_diagram.md -o ../docs/rendered/system_architecture_diagram_rendered.md -a ../docs/rendered -e svg -p ../docs/rendered/puppeteer-config.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@uiw/react-codemirror": "^4.23.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.27.0",
    "react-is": "^19.2.6",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.13"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.2.5",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
